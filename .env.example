# Copy this file to .env for local development (node dev-server.js reads it).
# On Vercel, set the same names under Project Settings -> Environment Variables.
# NEVER commit a real .env file or put these values in browser code.

# --- AI scan reports (required for real analysis) ---
ANTHROPIC_API_KEY=
# GB_MODEL=claude-opus-5-5     # default. claude-sonnet-5-5 is cheaper: test it on your sample scans first
# GB_EFFORT=high               # low | medium | high | xhigh | max
# GB_FALLBACKS=0               # set 0 to turn off the server-side refusal fallback

# --- Accounts (Supabase: Project Settings -> API) ---
# The anon key is meant to be public; row-level security protects the data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Demo helpers ---
# GYMBOY_MOCK_AI=1             # the server returns the bundled sample report instead of calling the API
# GYMBOY_ALLOW_ANON=1          # live site only: allow scans without Supabase auth (not recommended)
