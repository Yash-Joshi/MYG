{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GymBoyScanReport",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "needs_better_image",
        "not_a_scan",
        "needs_attention"
      ],
      "description": "ok = fully read; partial = some metrics unreadable; needs_better_image = unreadable; not_a_scan = not an InBody result; needs_attention = images disagree with each other or with the profile"
    },
    "user_message": {
      "type": [
        "string",
        "null"
      ],
      "description": "Plain-language message for the user when status is not ok (what to fix, e.g. retake with the whole sheet in frame)"
    },
    "scan": {
      "type": "object",
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "inbody_printout",
            "inbody_app_screenshot",
            "mixed",
            "unknown"
          ]
        },
        "device_model": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. 'InBody 570' if printed"
        },
        "measured_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601 date-time or date, as printed"
        },
        "images_used": {
          "type": "integer"
        },
        "units": {
          "type": "object",
          "properties": {
            "mass": {
              "type": "string",
              "enum": [
                "kg",
                "lb"
              ]
            },
            "length": {
              "type": "string",
              "enum": [
                "cm",
                "in"
              ]
            }
          },
          "required": [
            "mass",
            "length"
          ],
          "additionalProperties": false,
          "description": "Units printed on the sheet. All numbers below are already normalised to kg / cm."
        },
        "person": {
          "type": "object",
          "properties": {
            "age": {
              "type": [
                "integer",
                "null"
              ]
            },
            "sex": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "male",
                "female",
                null
              ]
            },
            "height_cm": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "age",
            "sex",
            "height_cm"
          ],
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "properties": {
            "overall": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "overall",
            "issues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source_type",
        "device_model",
        "measured_at",
        "images_used",
        "units",
        "person",
        "quality"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "weight",
              "skeletal_muscle_mass",
              "body_fat_mass",
              "body_fat_percent",
              "lean_body_mass",
              "total_body_water",
              "dry_lean_mass",
              "protein_mass",
              "mineral_mass",
              "bmi",
              "bmr",
              "visceral_fat_level",
              "visceral_fat_area",
              "ecw_tbw_ratio",
              "inbody_score",
              "waist_hip_ratio",
              "body_cell_mass"
            ]
          },
          "label": {
            "type": "string",
            "description": "Short human label, e.g. 'Skeletal muscle mass'"
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "description": "Number exactly as printed, in `unit`. null if present but unreadable."
          },
          "unit": {
            "type": "string",
            "description": "kg, %, kcal, level, cm2, ratio, points"
          },
          "range_low": {
            "type": [
              "number",
              "null"
            ]
          },
          "range_high": {
            "type": [
              "number",
              "null"
            ]
          },
          "range_source": {
            "type": "string",
            "enum": [
              "printed",
              "reference",
              "none"
            ],
            "description": "printed = read from the sheet; reference = fallback table in the prompt; none = no range available"
          },
          "status": {
            "type": "string",
            "enum": [
              "below",
              "within",
              "above",
              "unknown"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Only when something needs saying about this value, e.g. 'glare over the digits'"
          }
        },
        "required": [
          "key",
          "label",
          "value",
          "unit",
          "range_low",
          "range_high",
          "range_source",
          "status",
          "confidence",
          "note"
        ],
        "additionalProperties": false,
        "description": "One measured value found in the images. Omit metrics that are not on the sheet."
      }
    },
    "segments": {
      "type": "object",
      "properties": {
        "lean": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "right_arm": {
                  "type": "object",
