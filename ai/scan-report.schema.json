                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "kg"
                    },
                    "percent_of_ideal": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "The sheet's % of normal/ideal for this segment"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "below",
                        "normal",
                        "above",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "mass",
                    "percent_of_ideal",
                    "status"
                  ],
                  "additionalProperties": false
                },
                "left_leg": {
                  "type": "object",
                  "properties": {
                    "mass": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "kg"
                    },
                    "percent_of_ideal": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "The sheet's % of normal/ideal for this segment"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "below",
                        "normal",
                        "above",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "mass",
                    "percent_of_ideal",
                    "status"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "right_arm",
                "left_arm",
                "trunk",
                "right_leg",
                "left_leg"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "fat": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "right_arm": {
                  "type": "object",
                  "properties": {
                    "mass": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "kg"
                    },
                    "percent_of_ideal": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "The sheet's % of normal/ideal for this segment"
                    },
                    "status": {
                      "type": "string",
