                "type": "string"
              },
              "description": "0-3 short bullets"
            },
            "next_scan": {
              "type": "object",
              "properties": {
                "suggested_in_days": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "tips": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "How to get a comparable scan next time"
                }
              },
              "required": [
                "suggested_in_days",
                "tips"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "training",
            "nutrition",
            "recovery",
            "next_scan"
          ],
          "additionalProperties": false
        },
        "glossary": {
          "type": "array",
