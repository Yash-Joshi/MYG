                      "number",
                      "null"
                    ]
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down",
                      "flat"
                    ]
                  },
                  "meaning": {
                    "type": "string",
                    "enum": [
                      "improving",
                      "neutral",
                      "worsening",
                      "within_normal_variation"
                    ],
                    "description": "Judged against the user's goal; small changes are within_normal_variation"
                  }
                },
                "required": [
                  "key",
                  "previous",
                  "current",
                  "delta",
                  "delta_percent",
                  "direction",
                  "meaning"
                ],
                "additionalProperties": false
              }
            },
            "summary": {
              "type": "string",
              "description": "One or two plain sentences"
            }
          },
          "required": [
            "previous_measured_at",
            "items",
            "summary"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
