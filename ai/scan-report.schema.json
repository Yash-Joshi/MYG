    "report": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "description": "One honest, encouraging sentence, <= 20 words"
        },
        "score": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "description": "e.g. 'InBody score'"
                },
                "value": {
                  "type": "number"
                },
                "max": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "label",
                "value",
                "max"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "insights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "<= 25 words, cites a specific number from the scan"
              },
              "sentiment": {
                "type": "string",
                "enum": [
                  "positive",
                  "neutral",
                  "attention"
                ]
              },
              "metric_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "weight",
                    "skeletal_muscle_mass",
                    "body_fat_mass",
                    "body_fat_percent",
                    "lean_body_mass",
                    "total_body_water",
                    "dry_lean_mass",
                    "protein_mass",
                    "mineral_mass",
                    "bmi",
                    "bmr",
                    "visceral_fat_level",
                    "visceral_fat_area",
                    "ecw_tbw_ratio",
                    "inbody_score",
                    "waist_hip_ratio",
                    "body_cell_mass"
                  ]
                }
              }
            },
            "required": [
              "text",
              "sentiment",
              "metric_keys"
            ],
            "additionalProperties": false
          },
          "description": "3 to 5 items"
        },
        "focus_areas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "why": {
                "type": "string",
                "description": "Tied to a number from the scan or the profile"
              },
              "action": {
                "type": "string",
                "description": "One concrete thing to do this week"
              },
              "area": {
                "type": "string",
                "enum": [
                  "training",
                  "nutrition",
                  "recovery",
                  "lifestyle",
                  "measurement"
                ]
              }
            },
            "required": [
              "title",
              "why",
              "action",
              "area"
            ],
            "additionalProperties": false
          },
          "description": "At most 3 items"
        },
        "coaching": {
          "type": "object",
          "properties": {
            "training": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "0-4 short bullets"
            },
            "nutrition": {
              "type": "object",
              "properties": {
                "protein_g_min": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "grams per day"
                },
                "protein_g_max": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "grams per day"
                },
                "calorie_guidance": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "A cautious range or direction, never below the BMR on the sheet"
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "protein_g_min",
                "protein_g_max",
                "calorie_guidance",
                "notes"
              ],
              "additionalProperties": false
            },
            "recovery": {
              "type": "array",
