                        "null"
                      ],
                      "description": "kg"
                    },
                    "percent_of_ideal": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "The sheet's % of normal/ideal for this segment"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "below",
                        "normal",
                        "above",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "mass",
                    "percent_of_ideal",
                    "status"
                  ],
                  "additionalProperties": false
                },
                "right_leg": {
