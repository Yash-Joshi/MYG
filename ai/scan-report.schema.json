              },
              "required": [
                "right_arm",
                "left_arm",
                "trunk",
                "right_leg",
                "left_leg"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lean",
        "fat"
      ],
      "additionalProperties": false,
      "description": "Segmental analysis from the sheet"
    },
    "balance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pair": {
            "type": "string",
            "enum": [
              "arms",
              "legs"
            ]
          },
          "left_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "right_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "diff_percent": {
            "type": [
              "number",
              "null"
            ],
            "description": "|left-right| / the larger side * 100, one decimal"
          },
          "flag": {
            "type": "string",
            "enum": [
              "none",
              "mild",
              "notable",
              "unknown"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "pair",
          "left_value",
          "right_value",
          "diff_percent",
          "flag",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "trend": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "previous_measured_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "ISO 8601 date"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "weight",
                      "skeletal_muscle_mass",
                      "body_fat_mass",
                      "body_fat_percent",
                      "lean_body_mass",
                      "total_body_water",
                      "dry_lean_mass",
                      "protein_mass",
                      "mineral_mass",
                      "bmi",
                      "bmr",
