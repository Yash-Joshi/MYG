              },
              "plain_meaning": {
                "type": "string"
              }
            },
            "required": [
              "term",
              "plain_meaning"
            ],
            "additionalProperties": false
          },
          "description": "Only terms used in the text above"
        }
      },
      "required": [
        "headline",
        "score",
        "insights",
        "focus_areas",
        "coaching",
        "glossary"
      ],
      "additionalProperties": false
